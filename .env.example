# Django
DJANGO_SECRET_KEY=change-me-in-env
DJANGO_DEBUG=True
# Production only (comma-separated)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL
MYSQL_DATABASE=eodiganam
MYSQL_USER=eodiganam
MYSQL_PASSWORD=change-me-in-env
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MIN=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=14

# Email
EMAIL_VERIFICATION_CODE_LIFETIME_MIN=5
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Social Login
GOOGLE_CLIENT_ID=change-me-in-env
KAKAO_REST_API_KEY=change-me-in-env

# Tour API
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_SERVICE_KEY=change-me-in-env
TOUR_API_TIMEOUT_SEC=5

# KMA (기상청) UltraSrtNcst API
KMA_API_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService2.0
KMA_API_SERVICE_KEY=change-me-in-env
KMA_API_TIMEOUT_SEC=5

# Tourist Congestion Forecast API
TOUR_CONGESTION_API_BASE_URL=https://apis.data.go.kr/B551011/TatsCnctrRateService
TOUR_CONGESTION_API_SERVICE_KEY=change-me-in-env
TOUR_CONGESTION_API_TIMEOUT_SEC=5

# Kakao Mobility API
